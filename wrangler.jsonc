{
  // Cloudflare: build the site into ./public, then serve only that folder
  // (serving the repo root also uploaded node_modules, over the size limit).
  "name": "instagram-follower-checker",
  "compatibility_date": "2026-09-26",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./public",
    // (index.html served as it is, not sent on to "/": the offline copy of
    // a redirect won't open, so the installed app showed an error offline)
    "html_handling": "none",
    // (and "/" is index.html — with no html handling it was a 404)
    "not_found_handling": "single-page-application"
  }
}
